<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_ActualizarPermisosTiempo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/turrialba">


    <ImageView
        android:id="@+id/id_img_bienvenidaActualizarPermisoTiempo"
        android:layout_width="282dp"
        android:layout_height="162dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/logito6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/id_SeccionesActualizarPermisosTiempo"
        android:layout_width="367dp"
        android:layout_height="470dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/border_radius"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/id_img_bienvenidaActualizarPermisoTiempo" />

    <LinearLayout
        android:id="@+id/lnl_ContenidoActualizarPermisosTiempo"
        android:layout_width="367dp"
        android:layout_height="435dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/id_SeccionesActualizarPermisosTiempo"
        app:layout_constraintEnd_toEndOf="@+id/id_SeccionesActualizarPermisosTiempo"
        app:layout_constraintHorizontal_bias="0.194"
        app:layout_constraintStart_toStartOf="@+id/id_SeccionesActualizarPermisosTiempo"
        app:layout_constraintTop_toTopOf="@+id/id_SeccionesActualizarPermisosTiempo"
        app:layout_constraintVertical_bias="0.0">

        <TextView
            android:id="@+id/txt_TituloActualizarPermisosTiempo"
            android:layout_width="325dp"
            android:layout_height="33dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:fontFamily="sans-serif"
            android:paddingTop="3dp"
            android:text="Actualizar el permiso de tiempo:"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:typeface="normal" />

        <ScrollView
            android:id="@+id/sv_ScrollVertical_ActualizarPermisosTiempo"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/lnl_ContenidoVertical_ActualizarPermisosTiempo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_NombrePermisoTiempo_Actualizado"
                    android:layout_width="325dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="22dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/border_text"
                    android:fontFamily="sans-serif"
                    android:hint="Nombre:"
                    android:longClickable="false"
                    android:paddingStart="5dp"
                    android:paddingTop="5dp"
                    android:textAlignment="textStart"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:textSize="20sp"
                    android:textStyle="italic"
                    android:typeface="normal" />

                <TextView
                    android:id="@+id/txt_ApellidosPermisoTiempo_Actualizado"
                    android:layout_width="325dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="22dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/border_text"
                    android:fontFamily="sans-serif"
                    android:hint="Apellidos:"
                    android:inputType="text"
                    android:longClickable="false"
                    android:paddingStart="5dp"
                    android:paddingTop="5dp"
                    android:textAlignment="textStart"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:textSize="20sp"
                    android:textStyle="italic"
                    android:typeface="normal" />

                <TextView
                    android:id="@+id/txt_CedulaPermisosTiempoActualizado"
                    android:layout_width="325dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="22dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/border_text"
                    android:fontFamily="sans-serif"
                    android:hint="Cédula:"
                    android:inputType="text"
                    android:longClickable="false"
                    android:paddingStart="5dp"
                    android:paddingTop="5dp"
                    android:textAlignment="textStart"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:textSize="20sp"
                    android:textStyle="italic"
                    android:typeface="normal" />

                <EditText
                    android:id="@+id/edtxt_TipoPermisoActualizada"
                    android:layout_width="325dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="22dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/border_text"
                    android:fontFamily="sans-serif"
                    android:hint="Tipo de permiso:"
                    android:inputType="text"
                    android:paddingStart="5dp"
                    android:paddingTop="5dp"
                    android:textAlignment="textStart"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:textSize="20sp"
                    android:textStyle="italic"
                    android:typeface="normal" />

                <EditText
                    android:id="@+id/edtxt_DescripcionPermisoTiempoActualizado"
                    android:layout_width="325dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="22dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/border_text"
                    android:fontFamily="sans-serif"
                    android:hint="Descripción:"
                    android:inputType="text"
                    android:paddingStart="5dp"
                    android:paddingTop="5dp"
                    android:textAlignment="textStart"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:textSize="20sp"
                    android:textStyle="italic"
                    android:typeface="normal" />

                <EditText
                    android:id="@+id/edtxt_FechaAsignacionPermisosTiempo_Actualizada"
                    android:layout_width="325dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/border_text"
                    android:fontFamily="sans-serif"
                    android:hint="Fecha de asignación:"
                    android:inputType="datetime"
                    android:paddingStart="5dp"
                    android:paddingTop="-5dp"
                    android:textAlignment="textStart"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:textSize="20sp"
                    android:textStyle="italic"
                    android:typeface="normal" />

                <EditText
                    android:id="@+id/edtxt_FechaFinalizacionPermisosTiempo_Actualizada"
                    android:layout_width="325dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/border_text"
                    android:fontFamily="sans-serif"
                    android:hint="Fecha de finalización:"
                    android:inputType="datetime"
                    android:paddingStart="5dp"
                    android:paddingTop="-5dp"
                    android:textAlignment="textStart"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:textSize="20sp"
                    android:textStyle="italic"
                    android:typeface="normal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ActualizarPermisoTiempo"
                    android:layout_width="199dp"
                    android:layout_height="63dp"
                    android:layout_marginStart="85dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/custom_buttons"
                    android:checked="true"
                    android:clickable="true"
                    android:fontFamily="sans-serif"
                    android:text="Actualizar"
                    android:textAlignment="center"
                    android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:typeface="normal"
                    app:backgroundTint="@null"
                    app:icon="@drawable/icono_actualizar"
                    app:iconPadding="8dp"
                    app:iconSize="40dp"
                    app:iconTint="@color/black" />

                <ImageView
                    android:id="@+id/img_fotoActualizarPermisoTiempo"
                    android:layout_width="304dp"
                    android:layout_height="226dp"
                    android:layout_marginStart="31dp"
                    android:layout_marginTop="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icono_contenido_no_disponible"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txt_MensajeActualizarPermisoTiempo"
                    android:layout_width="328dp"
                    android:layout_height="201dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="19dp"
                    android:layout_marginTop="15dp"
                    android:fontFamily="sans-serif"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:typeface="normal"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <TextView
        android:id="@+id/txt_informacionFechaActualizar"
        android:layout_width="367dp"
        android:layout_height="55dp"
        android:background="@drawable/custom_information"
        android:fontFamily="sans-serif"
        android:paddingStart="0dp"
        android:paddingTop="1dp"
        android:text="@string/InformacionFecha_PermisosTiempo"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold|italic"
        android:typeface="normal"
        app:layout_constraintBottom_toTopOf="@+id/id_VistaDerechosCopy"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/id_SeccionesActualizarPermisosTiempo" />


    <View
        android:id="@+id/id_VistaDerechosCopy"
        android:layout_width="345dp"
        android:layout_height="72dp"
        android:background="@drawable/border_radius"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_informacionFechaActualizar" />

    <TextView
        android:id="@+id/txt_DerechosCopy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="© Copyright - Municipalidad de Turrialba."
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold|italic"
        android:typeface="normal"
        app:layout_constraintBottom_toTopOf="@+id/txt_DerechosCopy1"
        app:layout_constraintEnd_toEndOf="@+id/id_VistaDerechosCopy"
        app:layout_constraintStart_toStartOf="@+id/id_VistaDerechosCopy"
        app:layout_constraintTop_toTopOf="@+id/id_VistaDerechosCopy"
        app:layout_constraintVertical_bias="0.65" />

    <TextView
        android:id="@+id/txt_DerechosCopy1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="sans-serif"
        android:text="Todos los derechos reservados."
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold|italic"
        android:typeface="normal"
        app:layout_constraintBottom_toBottomOf="@+id/id_VistaDerechosCopy"
        app:layout_constraintEnd_toEndOf="@+id/id_VistaDerechosCopy"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="@+id/id_VistaDerechosCopy" />

</androidx.constraintlayout.widget.ConstraintLayout>