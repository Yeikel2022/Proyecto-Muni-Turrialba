<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".index.CarnetVirtualFragment">

    <!-- TODO: Update blank fragment layout -->
    <ImageView
        android:id="@+id/id_Vistabienvenida"
        android:layout_width="match_parent"
        android:layout_height="144dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="0dp"
        android:background="@drawable/turri15"
        android:scaleType="center"
        android:visibility="invisible" />

    <View
        android:id="@+id/id_SeccionInformativa"
        android:layout_width="356dp"
        android:layout_height="80dp"
        android:layout_alignBottom="@+id/id_Vistabienvenida"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="23dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="34dp"
        android:background="@drawable/border_radius" />


    <ImageView
        android:id="@+id/img_CarnetVirtual"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignStart="@+id/id_SeccionInformativa"
        android:layout_alignTop="@+id/id_SeccionInformativa"
        android:layout_alignBottom="@+id/id_SeccionInformativa"
        android:layout_marginStart="15dp"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/icono_bienvenida" />

    <TextView
        android:id="@+id/txt_carnetBienvenida"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_alignTop="@+id/id_SeccionInformativa"
        android:layout_alignEnd="@+id/id_SeccionInformativa"
        android:layout_alignBottom="@+id/id_SeccionInformativa"
        android:layout_toEndOf="@+id/img_CarnetVirtual"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:paddingTop="3dp"
        android:paddingEnd="25dp"
        android:text="¡Bienvenido(a) al carnet virtual de MuniTurrialba!"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        android:typeface="normal" />

    <ImageView
        android:id="@+id/img_carnetFotoPerfil"
        android:layout_width="374dp"
        android:layout_height="164dp"
        android:layout_below="@+id/id_Vistabienvenida"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/border_radius_new"
        android:scaleType="fitCenter"
        tools:src="@drawable/icono_perfil_logo" />

    <View
        android:id="@+id/id_seccionesCarnet"
        android:layout_width="match_parent"
        android:layout_height="551dp"
        android:layout_below="@+id/img_carnetFotoPerfil"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="0dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="77dp"
        android:background="@drawable/border_radius_new" />

    <LinearLayout
        android:id="@+id/lnl_SeccionCarnet"
        android:layout_width="match_parent"
        android:layout_height="450dp"
        android:layout_alignTop="@+id/id_seccionesCarnet"
        android:layout_alignBottom="@+id/id_seccionesCarnet"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="0dp"
        android:layout_marginTop="-1dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="1dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/img_CarnetQR"
            android:layout_width="362dp"
            android:layout_height="262dp"
            android:layout_marginStart="26dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="23dp"
            android:layout_marginBottom="0dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/icono_carnet_virtual" />

        <ImageView
            android:id="@+id/img_fotoCarnet"
            android:layout_width="match_parent"
            android:layout_height="264dp"
            android:layout_marginStart="67dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="70dp"
            android:layout_marginBottom="-70dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icono_contenido_no_disponible"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_MensajeCarnet"
            android:layout_width="392dp"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/id_seccionesCarnet"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="10dp"
            android:layout_marginTop="87dp"
            android:layout_marginEnd="10dp"
            android:fontFamily="sans-serif"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="30sp"
            android:textStyle="bold"
            android:typeface="normal"
            android:visibility="gone" />

    </LinearLayout>


</RelativeLayout>