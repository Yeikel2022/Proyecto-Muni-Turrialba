<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".index.MenuFragment">

    <!-- TODO: Update blank fragment layout -->

    <ImageView
        android:id="@+id/id_Vistabienvenida"
        android:layout_width="match_parent"
        android:layout_height="144dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="0dp"
        android:background="@drawable/turri15"
        android:scaleType="center"
        android:visibility="invisible" />

    <View
        android:id="@+id/id_SeccionInformativa"
        android:layout_width="356dp"
        android:layout_height="80dp"
        android:layout_alignBottom="@+id/id_Vistabienvenida"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="23dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="34dp"
        android:background="@drawable/border_radius" />

    <ImageView
        android:id="@+id/img_Menu"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignStart="@+id/id_SeccionInformativa"
        android:layout_alignTop="@+id/id_SeccionInformativa"
        android:layout_alignBottom="@+id/id_SeccionInformativa"
        android:layout_marginStart="15dp"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/icono_bienvenida" />

    <TextView
        android:id="@+id/txt_menuBienvenida"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_alignTop="@+id/id_SeccionInformativa"
        android:layout_alignEnd="@+id/id_SeccionInformativa"
        android:layout_alignBottom="@+id/id_SeccionInformativa"
        android:layout_toEndOf="@+id/img_Menu"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:paddingTop="3dp"
        android:paddingEnd="25dp"
        android:text="¡Bienvenido(a) al menú de MuniTurrialba!"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        android:typeface="normal" />

    <View
        android:id="@+id/id_SeccionesMenu"
        android:layout_width="match_parent"
        android:layout_height="551dp"
        android:layout_below="@+id/id_Vistabienvenida"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="0dp"
        android:layout_marginTop="69dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="67dp"
        android:background="@drawable/border_radius_new" />
<LinearLayout
        android:id="@+id/lnl_SeccionModulos"
        android:layout_width="match_parent"
        android:layout_height="597dp"
        android:layout_alignTop="@+id/id_SeccionesMenu"
        android:layout_alignBottom="@+id/id_SeccionesMenu"
        android:layout_marginTop="-1dp"
        android:layout_marginBottom="-1dp"
        android:orientation="vertical">

    <ScrollView
        android:id="@+id/sv_ScrollVertical_Modulos"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/lnl_ContenidoVertica_Modulos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ControlEmpleado"
                android:layout_width="392dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="34dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/custom_buttons"
                android:checked="true"
                android:clickable="true"
                android:fontFamily="sans-serif"
                android:insetTop="0dp"
                android:insetBottom="4dp"
                android:text="Control de empleados."
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                android:typeface="normal"
                app:backgroundTint="@null"
                app:cornerRadius="20dp"
                app:icon="@drawable/icono_control_empleados"
                app:iconPadding="0dp"
                app:iconSize="80dp"
                app:iconTint="@color/black" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_Reporteria"
                android:layout_width="392dp"
                android:layout_height="89dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="34dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/custom_buttons"
                android:checked="true"
                android:clickable="true"
                android:fontFamily="sans-serif"
                android:insetTop="0dp"
                android:insetBottom="4dp"
                android:text="Reporteria."
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                android:typeface="normal"
                app:backgroundTint="@null"
                app:cornerRadius="20dp"
                app:icon="@drawable/icono_reporteria"
                app:iconPadding="-45dp"
                app:iconSize="80dp"
                app:iconTint="@color/black" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_AdministracionArchivos"
                android:layout_width="392dp"
                android:layout_height="94dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="34dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/custom_buttons"
                android:checked="true"
                android:clickable="true"
                android:fontFamily="sans-serif"
                android:insetTop="0dp"
                android:insetBottom="4dp"
                android:text="Administración de archivos."
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                android:typeface="normal"
                app:backgroundTint="@null"
                app:cornerRadius="20dp"
                app:icon="@drawable/icono_administracion_archivos"
                app:iconPadding="10dp"
                app:iconSize="80dp"
                app:iconTint="@color/black" />
        </LinearLayout>
    </ScrollView>

    <ImageView
        android:id="@+id/img_fotoMenu"
        android:layout_width="match_parent"
        android:layout_height="264dp"
        android:layout_marginStart="67dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="70dp"
        android:layout_marginBottom="-70dp"
        android:scaleType="fitCenter"
        android:src="@drawable/icono_contenido_no_disponible"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txt_MensajeMenu"
        android:layout_width="392dp"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/id_SeccionesMenu"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="10dp"
        android:layout_marginTop="87dp"
        android:layout_marginEnd="10dp"
        android:fontFamily="sans-serif"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="30sp"
        android:textStyle="bold"
        android:typeface="normal"
        android:visibility="gone" />

</LinearLayout>

