<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_AyudaActualizar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/turrialba">


    <ImageView
        android:id="@+id/id_img_bienvenidaActualizarAyuda"
        android:layout_width="310dp"
        android:layout_height="178dp"
        android:layout_marginStart="31dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/logito6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/id_SeccionesActualizarAyuda"
        android:layout_width="367dp"
        android:layout_height="450dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/border_radius"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/id_img_bienvenidaActualizarAyuda" />

    <LinearLayout
        android:id="@+id/lnl_ContenidoActualizarAyuda"
        android:layout_width="367dp"
        android:layout_height="450dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/id_SeccionesActualizarAyuda"
        app:layout_constraintEnd_toEndOf="@+id/id_SeccionesActualizarAyuda"
        app:layout_constraintStart_toStartOf="@+id/id_SeccionesActualizarAyuda"
        app:layout_constraintTop_toTopOf="@+id/id_SeccionesActualizarAyuda">

        <TextView
            android:id="@+id/txt_TituloActualizarAyuda"
            android:layout_width="325dp"
            android:layout_height="33dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif"
            android:paddingTop="2dp"
            android:paddingEnd="15dp"
            android:text="Actualizar registro FAQ:"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:typeface="normal" />

        <TextView
            android:id="@+id/txt_InfoActualizarAyuda"
            android:layout_width="325dp"
            android:layout_height="180dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif"
            android:paddingStart="5dp"
            android:text="@string/InformacionActualizarFAQ"
            android:textAlignment="textStart"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="italic"
            android:typeface="normal" />

        <EditText
            android:id="@+id/edtxt_PreguntaActualizar"
            android:layout_width="325dp"
            android:layout_height="40dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/border_text"
            android:fontFamily="sans-serif"
            android:hint="Pregunta:"
            android:inputType="text"
            android:paddingStart="5dp"
            android:textAlignment="textStart"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="@color/black"
            android:textColorHint="@color/black"
            android:textSize="20sp"
            android:textStyle="italic"
            android:typeface="normal" />

        <EditText
            android:id="@+id/edtxt_RespuestaActualizar"
            android:layout_width="325dp"
            android:layout_height="40dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/border_text"
            android:fontFamily="sans-serif"
            android:hint="Respuesta:"
            android:inputType="text"
            android:paddingStart="5dp"
            android:textAlignment="textStart"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="@color/black"
            android:textColorHint="@color/black"
            android:textSize="20sp"
            android:textStyle="italic"
            android:typeface="normal" />

        <Spinner
            android:id="@+id/sp_tipoPrioridadActualizar"
            android:layout_width="325dp"
            android:layout_height="40dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/border_text"
            android:dropDownWidth="325dp"
            android:entries="@array/listaTipo_Prioridades"
            android:paddingStart="5dp"
            android:popupBackground="@drawable/border_text"
            android:spinnerMode="dropdown" />

        <ImageView
            android:id="@+id/img_fotoActualizarAyuda"
            android:layout_width="304dp"
            android:layout_height="226dp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icono_contenido_no_disponible"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_MensajeActualizarAyuda"
            android:layout_width="328dp"
            android:layout_height="201dp"
            android:layout_alignTop="@+id/id_SeccionesActualizarAyuda"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="20dp"
            android:layout_marginTop="15dp"
            android:fontFamily="sans-serif"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="30sp"
            android:textStyle="bold"
            android:typeface="normal"
            android:visibility="gone" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_Actualizar"
        android:layout_width="190dp"
        android:layout_height="63dp"
        android:background="@drawable/custom_buttons"
        android:checked="true"
        android:clickable="true"
        android:fontFamily="sans-serif"
        android:text="Actualizar"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        android:typeface="normal"
        app:backgroundTint="@null"
        app:icon="@drawable/icono_actualizar"
        app:iconPadding="8dp"
        app:iconSize="40dp"
        app:iconTint="@color/black"
        app:layout_constraintBottom_toTopOf="@+id/id_VistaDerechosCopy"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/id_SeccionesActualizarAyuda" />

    <View
        android:id="@+id/id_VistaDerechosCopy"
        android:layout_width="345dp"
        android:layout_height="72dp"
        android:background="@drawable/border_radius"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_Actualizar" />

    <TextView
        android:id="@+id/txt_DerechosCopy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="© Copyright - Municipalidad de Turrialba."
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold|italic"
        android:typeface="normal"
        app:layout_constraintBottom_toTopOf="@+id/txt_DerechosCopy1"
        app:layout_constraintEnd_toEndOf="@+id/id_VistaDerechosCopy"
        app:layout_constraintStart_toStartOf="@+id/id_VistaDerechosCopy"
        app:layout_constraintTop_toTopOf="@+id/id_VistaDerechosCopy"
        app:layout_constraintVertical_bias="0.65" />

    <TextView
        android:id="@+id/txt_DerechosCopy1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="sans-serif"
        android:text="Todos los derechos reservados."
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold|italic"
        android:typeface="normal"
        app:layout_constraintBottom_toBottomOf="@+id/id_VistaDerechosCopy"
        app:layout_constraintEnd_toEndOf="@+id/id_VistaDerechosCopy"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="@+id/id_VistaDerechosCopy" />

</androidx.constraintlayout.widget.ConstraintLayout>