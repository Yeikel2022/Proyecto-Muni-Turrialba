        android:layout_marginTop="13dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/icono_bienvenida" />

    <TextView
        android:id="@+id/txt_controlSalarios_Bienvenida"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_alignTop="@+id/id_SeccionSalariosInformativa"
        android:layout_alignEnd="@+id/id_SeccionSalariosInformativa"
        android:layout_alignBottom="@+id/id_SeccionSalariosInformativa"
