<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".moduloEmpleados.ControlSalarioFragment">

    <!-- TODO: Update blank fragment layout -->


    <View
        android:id="@+id/id_SeccionSalariosInformativa"
        android:layout_width="356dp"
        android:layout_height="80dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="23dp"
        android:layout_marginTop="23dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/border_radius"
        android:visibility="visible" />


    <ImageView
        android:id="@+id/img_ControlSalarios"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignStart="@+id/id_SeccionSalariosInformativa"
        android:layout_alignTop="@+id/id_SeccionSalariosInformativa"
        android:layout_alignEnd="@+id/id_SeccionSalariosInformativa"
        android:layout_alignBottom="@+id/id_SeccionSalariosInformativa"
        android:layout_marginStart="15dp"
        android:layout_marginTop="13dp"
        android:layout_marginEnd="285dp"
        android:layout_marginBottom="11dp"
        android:background="@drawable/icono_bienvenida" />

    <TextView
        android:id="@+id/txt_controlSalarios_Bienvenida"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_alignStart="@+id/id_SeccionSalariosInformativa"
        android:layout_alignTop="@+id/id_SeccionSalariosInformativa"
        android:layout_alignEnd="@+id/id_SeccionSalariosInformativa"
        android:layout_alignBottom="@+id/id_SeccionSalariosInformativa"
        android:layout_marginStart="76dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="9dp"
        android:layout_marginBottom="0dp"
        android:paddingTop="3dp"
        android:text="¡Bienvenido(a) al apartado de control de salarios de MuniTurrialba!"
        android:textAlignment="viewStart"
        android:textColor="@color/black"
        android:textSize="18sp" />

    <SearchView
        android:id="@+id/sv_buscarSalarios"
        android:layout_width="149dp"
        android:layout_height="59dp"
        android:layout_below="@+id/id_SeccionSalariosInformativa"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="67dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="70dp"
        android:background="@drawable/border_radius"
        android:closeIcon="@drawable/icono_busqueda_cerrar"
        android:paddingStart="7dp"
        android:searchHintIcon="@drawable/icono_busqueda_filtrar"
        android:searchIcon="@drawable/icono_busqueda_filtrar" />

    <View
