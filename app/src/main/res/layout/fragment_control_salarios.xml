        <Button
            android:id="@+id/btn_CrearSalarios"
            android:layout_width="128dp"
            android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="33dp"
            android:layout_marginEnd="297dp"
            android:layout_marginBottom="-1062dp"
            android:background="@drawable/custom_buttons_menu"
            android:clickable="true"
            android:fontFamily="sans-serif"
            android:paddingStart="12dp"
            android:text="Añadir"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="visible"
            app:backgroundTint="@null"
            app:cornerRadius="20dp"
            app:icon="@drawable/icono_agregar"
            app:iconPadding="2dp"
            app:iconSize="25dp" />

        <Button
            android:id="@+id/btn_ActualizarSalarios"
            android:layout_width="128dp"
            android:layout_height="56dp"
            android:layout_marginStart="145dp"
            android:layout_marginTop="1005dp"
            android:layout_marginEnd="154dp"
            android:layout_marginBottom="462dp"
            android:background="@drawable/custom_buttons_menu"
            android:clickable="true"
            android:fontFamily="sans-serif"
            android:paddingStart="12dp"
            android:text="Editar"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="visible"
            app:backgroundTint="@null"
            app:cornerRadius="20dp"
            app:icon="@drawable/icono_actualizar"
            app:iconPadding="2dp"
            app:iconSize="25dp" />

        <Button
            android:id="@+id/btn_EliminarSalarios"
