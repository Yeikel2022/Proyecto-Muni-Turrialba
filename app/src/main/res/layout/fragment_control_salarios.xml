                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TableRow
                                android:id="@+id/tbr_PrimeraFilaSalarios"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/border_table">

                                <CheckBox
                                    android:id="@+id/btn_SeleccionDatoSalarios"
                                    android:layout_width="35dp"
                                    android:layout_height="30dp"
                                    android:layout_marginStart="7dp"
                                    android:layout_marginEnd="7dp"
                                    android:buttonTint="@color/white" />

                                <TextView
                                    android:id="@+id/txt_NombreSalario"
                                    android:layout_width="205dp"
                                    android:layout_height="205dp"
                                    android:layout_marginStart="7dp"
                                    android:layout_span="1"
                                    android:fontFamily="sans-serif"
                                    android:hint="Nombre:"
                                    android:textAlignment="viewStart"
                                    android:textColor="@color/black"
                                    android:textColorHint="@color/black"
                                    android:textSize="18sp"
                                    android:textStyle="italic" />

                                <TextView
                                    android:id="@+id/txt_ApellidoSalario"
                                    android:layout_width="205dp"
                                    android:layout_height="205dp"
                                    android:layout_marginStart="7dp"
                                    android:layout_span="1"
                                    android:fontFamily="sans-serif"
                                    android:hint="Apellido:"
                                    android:textAlignment="viewStart"
                                    android:textColor="@color/black"
                                    android:textColorHint="@color/black"
                                    android:textSize="18sp"
                                    android:textStyle="italic" />

                                <TextView
                                    android:id="@+id/txt_EdadSalario"
                                    android:layout_width="205dp"
                                    android:layout_height="205dp"
                                    android:layout_marginStart="7dp"
                                    android:layout_span="1"
                                    android:fontFamily="sans-serif"
                                    android:hint="Edad:"
                                    android:textAlignment="viewStart"
                                    android:textColor="@color/black"
                                    android:textColorHint="@color/black"
                                    android:textSize="18sp"
                                    android:textStyle="italic" />

                                <TextView
                                    android:id="@+id/txt_CedulaSalario"
