                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ScrollView
                    android:id="@+id/sv_ScrollVerticalReporteTiempo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:id="@+id/lnl_ContenidoVerticalReporteTiempo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TableLayout
                            android:id="@+id/tbl_TablaInfoReporteTiempo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <TableRow
                                android:id="@+id/tbr_InfoFilaReporteTiempo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/border_table">

                                <TextView
                                    android:id="@+id/txt_InfoSeleccionReportes_TiempoGenerar"
                                    android:layout_width="30dp"
                                    android:layout_height="40dp"
                                    android:layout_marginStart="7dp"
                                    android:layout_marginEnd="7dp"
                                    android:fontFamily="sans-serif"
                                    android:paddingTop="5dp"
                                    android:text="✓"
                                    android:textAlignment="center"
                                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                    android:textColor="@color/black"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:typeface="normal" />

                                <TextView
                                    android:id="@+id/txt_InfoNombreReportes_TiempoGenerar"
                                    android:layout_width="350dp"
                                    android:layout_height="40dp"
                                    android:layout_marginStart="-1dp"
                                    android:background="@drawable/border_table_row"
                                    android:fontFamily="sans-serif"
                                    android:paddingStart="11dp"
                                    android:paddingTop="5dp"
                                    android:text="Nombre:"
                                    android:textAlignment="textStart"
                                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                    android:textColor="@color/black"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:typeface="normal" />

                                <TextView
                                    android:id="@+id/txt_InfoApellidosReportes_TiempoGenerar"
                                    android:layout_width="350dp"
                                    android:layout_height="40dp"
                                    android:layout_marginStart="-1dp"
                                    android:background="@drawable/border_table_row"
                                    android:fontFamily="sans-serif"
                                    android:paddingStart="11dp"
                                    android:paddingTop="5dp"
                                    android:text="Apellidos:"
                                    android:textAlignment="textStart"
                                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                    android:textColor="@color/black"
                                    android:textColorHint="@color/black"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:typeface="normal" />

                                <TextView
                                    android:id="@+id/txt_InfoCedulaReportes_TiempoGenerar"
                                    android:layout_width="350dp"
                                    android:layout_height="40dp"
                                    android:layout_marginStart="-1dp"
                                    android:background="@drawable/border_table_row"
                                    android:fontFamily="sans-serif"
                                    android:paddingStart="11dp"
                                    android:paddingTop="5dp"
                                    android:text="Cédula:"
                                    android:textAlignment="textStart"
                                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                    android:textColor="@color/black"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:typeface="normal" />

                                <TextView
                                    android:id="@+id/txt_InfoDepartamentoReportes_TiempoGenerar"
                                    android:layout_width="350dp"
                                    android:layout_height="40dp"
                                    android:layout_marginStart="-1dp"
                                    android:background="@drawable/border_table_row"
                                    android:fontFamily="sans-serif"
                                    android:paddingStart="11dp"
                                    android:paddingTop="5dp"
                                    android:text="Departamento:"
                                    android:textAlignment="textStart"
                                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                    android:textColor="@color/black"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:typeface="normal" />

                                <TextView
                                    android:id="@+id/txt_InfoTipoPermisoReportes_TiempoGenerar"
                                    android:layout_width="350dp"
                                    android:layout_height="40dp"
                                    android:layout_marginStart="-1dp"
                                    android:background="@drawable/border_table_row"
                                    android:fontFamily="sans-serif"
                                    android:paddingStart="11dp"
                                    android:paddingTop="5dp"
                                    android:text="Tipo de permiso:"
                                    android:textAlignment="textStart"
                                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                    android:textColor="@color/black"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:typeface="normal" />

                                <TextView
                                    android:id="@+id/txt_InfoDescripcionReportes_TiempoGenerar"
                                    android:layout_width="350dp"
                                    android:layout_height="40dp"
                                    android:layout_marginStart="-1dp"
                                    android:background="@drawable/border_table_row"
                                    android:fontFamily="sans-serif"
                                    android:paddingStart="11dp"
                                    android:paddingTop="5dp"
                                    android:text="Descripción:"
                                    android:textAlignment="textStart"
                                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                    android:textColor="@color/black"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:typeface="normal" />

                                <TextView
                                    android:id="@+id/txt_InfoFechaAsignacionReportes_TiempoGenerar"
                                    android:layout_width="350dp"
                                    android:layout_height="40dp"
                                    android:layout_marginStart="-1dp"
                                    android:background="@drawable/border_table_row"
                                    android:fontFamily="sans-serif"
                                    android:paddingStart="11dp"
                                    android:paddingTop="5dp"
                                    android:text="Fecha de asignación:"
                                    android:textAlignment="textStart"
                                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                    android:textColor="@color/black"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:typeface="normal" />

                                <TextView
                                    android:id="@+id/txt_InfoFechaFinalizacionReportes_TiempoGenerar"
                                    android:layout_width="350dp"
                                    android:layout_height="40dp"
                                    android:layout_marginStart="-1dp"
                                    android:background="@drawable/border_table_row"
                                    android:fontFamily="sans-serif"
                                    android:paddingStart="11dp"
                                    android:paddingTop="5dp"
                                    android:text="Fecha de finalización:"
                                    android:textAlignment="textStart"
                                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                    android:textColor="@color/black"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:typeface="normal" />

                            </TableRow>

                        </TableLayout>

                        <TableLayout
                            android:id="@+id/tbl_TablaReporteTiempo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/border_table">

                            <TableRow
                                android:id="@+id/tbr_PrimeraFilaReporteTiempo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <CheckBox
                                    android:id="@+id/btn_SeleccionDatoReportes_TiempoGenerar"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_marginStart="7dp"
                                    android:layout_marginTop="5dp"
                                    android:layout_marginEnd="7dp"
                                    android:buttonTint="@color/black"
                                    android:fontFamily="sans-serif"
                                    android:paddingTop="5dp"
                                    android:textAlignment="center"
                                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                    android:textColor="@color/black"
                                    android:textSize="20sp"
                                    android:textStyle="italic"
                                    android:typeface="normal" />

                                <TextView
                                    android:id="@+id/txt_NombreReportes_TiempoGenerar"
                                    android:layout_width="350dp"
                                    android:layout_height="180dp"
                                    android:layout_marginStart="-1dp"
                                    android:background="@drawable/border_table_row"
                                    android:fontFamily="sans-serif"
                                    android:hint="Nombre:"
                                    android:paddingStart="11dp"
                                    android:paddingTop="5dp"
                                    android:text="Nombre:"
                                    android:textAlignment="textStart"
                                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                    android:textColor="@color/black"
                                    android:textColorHint="@color/black"
                                    android:textSize="20sp"
                                    android:textStyle="italic"
                                    android:typeface="normal" />

                                <TextView
                                    android:id="@+id/txt_ApellidosReportes_TiempoGenerar"
                                    android:layout_width="350dp"
                                    android:layout_height="180dp"
                                    android:layout_marginStart="-1dp"
                                    android:background="@drawable/border_table_row"
                                    android:fontFamily="sans-serif"
                                    android:hint="Apellidos:"
                                    android:paddingStart="11dp"
                                    android:paddingTop="5dp"
                                    android:text="Apellidos:"
                                    android:textAlignment="textStart"
                                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                    android:textColor="@color/black"
                                    android:textColorHint="@color/black"
                                    android:textSize="20sp"
                                    android:textStyle="italic"
                                    android:typeface="normal" />

                                <TextView
                                    android:id="@+id/txt_CedulaReportes_TiempoGenerar"
                                    android:layout_width="350dp"
                                    android:layout_height="180dp"
                                    android:layout_marginStart="-1dp"
                                    android:background="@drawable/border_table_row"
                                    android:fontFamily="sans-serif"
                                    android:hint="Cédula:"
                                    android:paddingStart="11dp"
                                    android:paddingTop="5dp"
                                    android:text="Cédula:"
                                    android:textAlignment="textStart"
                                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                    android:textColor="@color/black"
                                    android:textColorHint="@color/black"
                                    android:textSize="20sp"
                                    android:textStyle="italic"
                                    android:typeface="normal" />

                                <TextView
                                    android:id="@+id/txt_DepartamentoReportes_TiempoGenerar"
                                    android:layout_width="350dp"
                                    android:layout_height="180dp"
                                    android:layout_marginStart="-1dp"
                                    android:background="@drawable/border_table_row"
                                    android:fontFamily="sans-serif"
                                    android:hint="Departamento:"
                                    android:paddingStart="11dp"
                                    android:paddingTop="5dp"
                                    android:text="Departamento:"
                                    android:textAlignment="textStart"
                                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                    android:textColor="@color/black"
                                    android:textColorHint="@color/black"
                                    android:textSize="20sp"
                                    android:textStyle="italic"
                                    android:typeface="normal" />

                                <TextView
                                    android:id="@+id/txt_TipoPermisoReportes_TiempoGenerar"
                                    android:layout_width="350dp"
                                    android:layout_height="180dp"
                                    android:layout_marginStart="-1dp"
                                    android:background="@drawable/border_table_row"
                                    android:fontFamily="sans-serif"
                                    android:hint="Tipo de permiso:"
                                    android:paddingStart="11dp"
                                    android:paddingTop="5dp"
                                    android:text="Tipo de permiso:"
                                    android:textAlignment="textStart"
                                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                    android:textColor="@color/black"
                                    android:textColorHint="@color/black"
                                    android:textSize="20sp"
                                    android:textStyle="italic"
                                    android:typeface="normal" />

                                <TextView
                                    android:id="@+id/txt_DescripcionReportes_TiempoGenerar"
                                    android:layout_width="350dp"
                                    android:layout_height="180dp"
                                    android:layout_marginStart="-1dp"
                                    android:background="@drawable/border_table_row"
                                    android:fontFamily="sans-serif"
                                    android:hint="Descripción:"
                                    android:paddingStart="11dp"
                                    android:paddingTop="5dp"
                                    android:text="Descripción:"
                                    android:textAlignment="textStart"
                                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                    android:textColor="@color/black"
                                    android:textColorHint="@color/black"
                                    android:textSize="20sp"
                                    android:textStyle="italic"
                                    android:typeface="normal" />

                                <TextView
                                    android:id="@+id/txt_FechaAsignacionReportes_TiempoGenerar"
                                    android:layout_width="350dp"
                                    android:layout_height="180dp"
                                    android:layout_marginStart="-1dp"
                                    android:background="@drawable/border_table_row"
                                    android:fontFamily="sans-serif"
                                    android:hint="Fecha de asignación:"
                                    android:paddingStart="11dp"
                                    android:paddingTop="5dp"
                                    android:text="Fecha de asignación:"
                                    android:textAlignment="textStart"
                                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                    android:textColor="@color/black"
                                    android:textColorHint="@color/black"
                                    android:textSize="20sp"
                                    android:textStyle="italic"
                                    android:typeface="normal" />

                                <TextView
                                    android:id="@+id/txt_FechaFinalizacionReportes_TiempoGenerar"
                                    android:layout_width="350dp"
                                    android:layout_height="180dp"
                                    android:layout_marginStart="-1dp"
                                    android:background="@drawable/border_table_row"
                                    android:fontFamily="sans-serif"
                                    android:hint="Fecha de finalización:"
                                    android:paddingStart="11dp"
                                    android:paddingTop="5dp"
                                    android:text="Fecha de finalización:"
                                    android:textAlignment="textStart"
                                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                    android:textColor="@color/black"
                                    android:textColorHint="@color/black"
                                    android:textSize="20sp"
                                    android:textStyle="italic"
                                    android:typeface="normal" />

                            </TableRow>

                        </TableLayout>
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </HorizontalScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_SeleccionarPermisoTiempo_Extra"
            android:layout_width="325dp"
            android:layout_height="63dp"
            android:layout_marginTop="25dp"
            android:background="@drawable/custom_information"
            android:checked="true"
            android:clickable="true"
            android:text="¿Añadir otro registro?"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:icon="@drawable/icono_agregar_reporte"
            app:iconPadding="-15dp"
            app:iconSize="40dp"
            app:iconTint="@color/black" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_GenerarReporteTiempo"
            android:layout_width="170dp"
            android:layout_height="63dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/custom_buttons"
            android:checked="true"
            android:clickable="true"
            android:fontFamily="sans-serif"
            android:text="Generar"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:typeface="normal"
            app:backgroundTint="@null"
            app:icon="@drawable/icono_generar"
            app:iconPadding="8dp"
            app:iconSize="40dp"
            app:iconTint="@color/black" />

        <ImageView
            android:id="@+id/img_fotoGenerarReportesTiempo"
            android:layout_width="304dp"
            android:layout_height="226dp"
            android:layout_marginTop="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icono_contenido_no_disponible"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_MensajeGenerarReportesTiempo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignTop="@+id/id_SeccionesGenerarTiempo"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="15dp"
            android:fontFamily="sans-serif"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="30sp"
            android:textStyle="bold"
            android:typeface="normal"
            android:visibility="gone" />
    </LinearLayout>


    <View
        android:id="@+id/id_VistaDerechosCopy"
        android:layout_width="345dp"
        android:layout_height="72dp"
        android:background="@drawable/border_radius"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/id_SeccionesGenerarTiempo"/>

    <TextView
        android:id="@+id/txt_DerechosCopy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="© Copyright - Municipalidad de Turrialba."
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold|italic"
        android:typeface="normal"
        app:layout_constraintBottom_toTopOf="@+id/txt_DerechosCopy1"
        app:layout_constraintEnd_toEndOf="@+id/id_VistaDerechosCopy"
        app:layout_constraintStart_toStartOf="@+id/id_VistaDerechosCopy"
        app:layout_constraintTop_toTopOf="@+id/id_VistaDerechosCopy"
        app:layout_constraintVertical_bias="0.65" />

    <TextView
        android:id="@+id/txt_DerechosCopy1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="sans-serif"
        android:text="Todos los derechos reservados."
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold|italic"
        android:typeface="normal"
        app:layout_constraintBottom_toBottomOf="@+id/id_VistaDerechosCopy"
        app:layout_constraintEnd_toEndOf="@+id/id_VistaDerechosCopy"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="@+id/id_VistaDerechosCopy" />


</androidx.constraintlayout.widget.ConstraintLayout>