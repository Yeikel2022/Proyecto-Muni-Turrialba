        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/id_SeccionesGenerarTiempo"
        app:layout_constraintEnd_toEndOf="@+id/id_SeccionesGenerarTiempo"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/id_SeccionesGenerarTiempo"
        app:layout_constraintTop_toTopOf="@+id/id_SeccionesGenerarTiempo"
        app:layout_constraintVertical_bias="0.0">

        <TextView
            android:id="@+id/txt_TituloGenerarTiempo"
            android:layout_width="325dp"
            android:layout_height="33dp"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif"
            android:paddingTop="5dp"
            android:text="Generar reporte de tiempo:"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:typeface="normal" />

        <HorizontalScrollView
            android:id="@+id/hsv_ScrollHorizontalReporteTiempo"
            android:layout_width="match_parent"
            android:layout_height="310dp"
            android:layout_marginTop="15dp">

            <LinearLayout
