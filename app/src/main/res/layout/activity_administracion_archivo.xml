<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_AdministracionArchivo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green">


    <FrameLayout
        android:id="@+id/framL_PlantillaAdministracionArchivos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/turrialba"
        app:layout_constraintBottom_toTopOf="@+id/btnV_BarraNavegacion_AdministracionArchivos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/btnV_BarraNavegacion_AdministracionArchivos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/green"
        app:itemIconTint="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/barra_opciones_administracion_archivos"/>

</androidx.constraintlayout.widget.ConstraintLayout>